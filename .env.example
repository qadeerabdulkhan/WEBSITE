# Copy to .env and fill in. Never commit .env.

PORT=3000
# Use development on your own computer; production on the live site (requires HTTPS).
NODE_ENV=development
# Your public site address. Payment gateways send customers back here.
BASE_URL=http://localhost:3000

# Where the database and uploaded photos are stored. On a host, point these at a persistent disk.
# DB_FILE=/data/zaqa.db
# UPLOADS_DIR=/data/uploads

# Admin account, created on first start.
ADMIN_EMAIL=admin@zaqa.pk
ADMIN_PASSWORD=change-me-to-something-long

# simulate = built-in test checkout (no real money)
# sandbox  = providers' test servers with your sandbox keys
# live     = real payments
PAYMENT_MODE=simulate

# JazzCash (Page Redirection / hosted checkout)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_TXN_TYPE=MWALLET

# Easypaisa (Easypay hosted checkout)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
# For server-side payment verification (Inquire Transaction API)
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_ACCOUNT_NUM=

# NayaPay: fill in after you receive NayaPay's merchant API documentation (see README)
NAYAPAY_MERCHANT_ID=
NAYAPAY_API_KEY=
NAYAPAY_SECRET=
NAYAPAY_API_BASE=

# Mastercard / Visa cards via Mastercard Payment Gateway Services (from your bank)
MPGS_GATEWAY_URL=https://test-gateway.mastercard.com
MPGS_MERCHANT_ID=
MPGS_API_PASSWORD=
MPGS_API_VERSION=73
